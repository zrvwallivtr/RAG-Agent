/* --- Theme --------------------------------------------------------------- */

$color-primary: cyan;
$color-primary-bright: lightcyan;
$color-primary-dim: darkcyan;
$color-highlight: yellow;
$color-on-primary: black;
$color-surface: black;
$color-overlay: rgba(0, 0, 0, 0.6);
$color-focus-border: $color-primary-bright;
$color-focus-tint: $color-primary 10%;
$color-transparent: transparent;


AttachmentsPopupScreen {
    align: center middle;
    background: $color-overlay;
}

#attachments-modal {
    max-width: 100;
    height: auto;
    border: solid $color-primary;
    min-height: 40;
    padding: 1 2;
}

.attachment-modal-list {
    height: auto;
    margin-top: 1;
}

.remove-attachment {
    min-width: 3;
    width: 3;
    height: 1;
    margin-right: 1;
}

.attachment-name {
    content-align: left middle;
}
