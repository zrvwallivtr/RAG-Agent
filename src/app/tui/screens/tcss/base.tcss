/* --- Theme --------------------------------------------------------------- */

$color-primary: #a0d0d5;
$color-status-bg: #04142a;
$color-status-fg: #2a7f9e;
$color-app-bg: #12181d;


/* --- App background ------------------------------------------------------ */

BaseScreen {
    background: $color-app-bg;
}


/* --- Command bar --------------------------------------------------------- */

#bottom-bar {
    dock: bottom;
    width: 100%;
    height: auto;
}

#status-row {
    width: 100%;
    height: 1;
    background: $color-status-bg;
}

#status-left {
    width: 1fr;
    height: 1;
    padding: 0 1;
    background: $color-status-bg;
    color: $color-status-fg;
}

#ruler {
    width: 19;
    height: 1;
    padding: 0 1;
    background: $color-status-bg;
    color: $color-status-fg;
    text-align: right;
}

#cmd-row {
    width: 100%;
    height: 1;
    background: $color-app-bg;
}

#cmd-input {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0;
    background: $color-app-bg;
    color: $color-primary;
}

/* Input's built-in :focus border would otherwise bring the border back */
#cmd-input:focus {
    border: none;
}

#cmd-input > .input--placeholder {
    color: $color-primary;
}

#showcmd {
    width: 12;
    height: 1;
    padding: 0 1;
    background: $color-app-bg;
    color: $color-primary;
    text-align: right;
}
