/* --- Theme --------------------------------------------------------------- */

$color-primary: #a0d0d5;
$color-overlay: rgba(0, 0, 0, 0.6);
$color-background: #12181d;


/* --- AttachmentsPopupScreen ---------------------------------------------- */

AttachmentsDialogScreen {
    align: center middle;
    background: $color-overlay;
}

#attachments-modal {
    max-width: 100;
    height: auto;
    border: solid $color-primary;
    min-height: 10;
    padding: 1 2;
    margin: 4;
    background: $color-background;
}

.attachment-modal-list {
    height: auto;
    margin-top: 1;
}

.remove-attachment {
    min-width: 3;
    width: 3;
    height: 1;
    margin-right: 1;
}

.attachment-name {
    content-align: left middle;
}
