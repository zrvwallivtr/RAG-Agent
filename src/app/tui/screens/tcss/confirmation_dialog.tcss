/* --- Theme --------------------------------------------------------------- */

$color-primary: #a0d0d5;
$color-primary-dim: darkcyan;
$color-on-primary: black;
$color-overlay: rgba(0, 0, 0, 0.6);


/* --- Confirmation popup -------------------------------------------------- */

ConfirmationDialogScreen {
    align: center middle;
    background: $color-overlay;
}

#confirmation-popup-modal {
    max-width: 100;
    height: auto;
    border: solid $color-primary;
    max-height: 60;
    padding: 1 2;
}

#confirmation-modal-title {
    height: auto;
    width: auto;
    align: center middle;
    margin: 1;
}

#confirmation-modal-button-section {
    align: center middle;
    height: auto;
    margin: 0 1;
    padding: 0 1;
}

#confirmation-modal-true-button {
    background: $color-primary;
    color: $color-on-primary;
}

#confirmation-modal-false-button {
    background: $color-primary-dim;
    color: $color-on-primary;
}
