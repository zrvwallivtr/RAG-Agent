ChatInterface {
    layout: vertical;
    width: 100%;
    height: 100%;
}

#chat-container {
    margin: 0 3;
    padding: 0 3;
}

#user-section {
    height: auto;
    width: 100%;
    border: solid darkcyan;
    margin: 1 3;
}

#sess-status {
    height: auto;
    width: 100%;
    padding: 0 1;
}

#prompt-input {
    width: 100%;
    height: auto;
    background: black;
}

#prompt-input:focus {
    border: solid cyan;
    color: cyan;
}

.user-item {
    width: auto;
    border: solid darkcyan;
    color: darkcyan;
    padding: 0 1;
    height: 3;
    margin-right: 1;
}

#attachment-indicator {
    width: auto;
}

#attachment-indicator:hover {
    border: cyan;
    color: cyan;
}

#attachment-indicator:focus {
    border: cyan;
    color: cyan;
}

#tokens-counter {
    width: auto;
}

.msg-box {
    height: auto;
}

.user-box {
    width: 100%;
    border: solid cyan;
    margin-left: 30;
    margin-right: 3;
    margin-bottom: 3;
    color: cyan;
    padding: 1 2;
}

.assistant-box {
    width: 100%;
    margin-left: 3;
    margin-bottom: 3;
    border-left: solid cyan;
    padding: 1 2;
}

.msg-token-count {
    color: darkcyan;
    width: auto;
    padding: 0 1;
    border: solid darkcyan;
}

.msg-token-count.hidden {
    display: none;
}
