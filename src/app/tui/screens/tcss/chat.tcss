/* --- Theme --------------------------------------------------------------- */

$color-primary: #a0d0d5;
$color-primary-bright: lightcyan;
$color-on-primary: #04142a;
$color-surface: #142831;
$color-focus-border: $color-primary-bright;
$color-focus-tint: $color-primary 10%;
$color-transparent: transparent;
$color-background: #12181d;


/* --- Chat area ----------------------------------------------------------- */

#chat-container {
    height: 1fr;
    margin: 0 1;
    padding: 0 1;
    scrollbar-size: 0 0;
    background: $color-background;
}


/* --- Message boxes: shared ----------------------------------------------- */

.msg-box {
    height: auto;
}

.msg-box:focus {
    background: $color-focus-tint;
}

.msg-token-count {
    width: auto;
    padding: 0 1;
    margin-left: 1;
    color: $color-primary;
}

MarkdownFence {
    border: heavy $color-transparent;
    overflow-x: auto;
    scrollbar-size-horizontal: 1;
    scrollbar-size-vertical: 0;
}

MarkdownFence.code-selected {
    border: heavy $color-focus-border;
}


/* --- Message boxes: user ------------------------------------------------- */

.msg-box.user-box {
    width: 100%;
    margin-left: 1;
    margin-right: 1;
    margin-bottom: 1;
    padding: 1 2;
    background: $color-surface;
}

.msg-box.user-box:focus {
    background: $color-focus-tint;
}

.user-attachments {
    width: 100%;
    height: auto;
    margin: 1 0;
    color: $color-primary;
}


/* --- Message boxes: assistant -------------------------------------------- */

.assistant-box {
    width: 100%;
    margin-left: 1;
    margin-right: 1;
    margin-bottom: 1;
    padding: 1;
}

.assistant-box.auto-summary {
    border: solid $color-primary;
    border-title-align: center;
    border-title-color: $color-primary;
    border-title-style: bold;
}


/* --- User section (status bar and prompt) -------------------------------- */

#prompt-row {
    width: 100%;
    height: auto;
    align-vertical: middle;
    margin: 1;
}

#prompt-prefix {
    width: 2;
    height: auto;
    color: $color-primary;
    border-top: solid $color-primary;
    border-bottom: solid $color-primary;
}

#stop-button {
    width: auto;
    border-top: solid $color-primary;
    border-bottom: solid $color-primary;
    color: $color-primary;
    background: transparent;
}

#stop-button:hover,
#stop-button:focus {
    color: $color-primary-bright;
    background: transparent;
}

#stop-button:disabled {
    opacity: 60%;
}

#prompt-input {
    width: 1fr;
    height: auto;
    border-top: solid $color-primary;
    border-bottom: solid $color-primary;
    background: transparent;
}

#user-section {
    height: auto;
}

#user-section:focus-within #prompt-prefix {
    color: $color-primary-bright;
}


/* --- Utilities ----------------------------------------------------------- */

.hidden {
    display: none;
}
