/* --- Variables -------------------------------------------------- */

$dash-accent: cyan;
$dash-highlight: yellow;


/* --- Screen ----------------------------------------------------- */

DashboardScreen {
    padding: 1 4;
}


/* --- App banner ------------------------------------------------- */

#app-banner {
    height: 13;
    margin-bottom: 1;
}

.box {
    height: 13;
}

#app-icon {
    width: 26;
    padding: 1;
    border: solid $dash-accent;
}

#app-config {
    margin-left: 3;
    padding-left: 3;
    border: solid $dash-accent;
}


/* --- Models ----------------------------------------------------- */

#model-section-title {
    height: auto;
}

#model-section-list {
    margin-left: 3;
    margin-bottom: 1;
}

.model-list {
    height: auto;
}

#model-type-list {
    max-width: 30;
}

#selected-model-list {
    color: $dash-highlight;
}


/* --- Tokenizers ------------------------------------------------- */

#tokenizer-section-title {
    height: auto;
}

#tokenizer-section-list {
    margin-left: 3;
}

.tokenizer-list {
    height: auto;
}

#fallback-tokenizer {
    max-width: 30;
}

#selected-tokenizer {
    color: $dash-highlight;
}


/* --- Sessions: title -------------------------------------------- */

#session-section-title {
    height: auto;
    margin-left: 1;
    margin-bottom: 1;
}


/* --- Sessions: action bar --------------------------------------- */

#session-action-bar {
    height: auto;
    padding-left: 1;
}

#search-session-button {
    width: auto;
}

#new-session-button {
    width: auto;
}

#delete-session-button {
    width: auto;
}

.action-item {
    color: $dash-accent;
    margin: 1 1 1 0;
}

.action-item:hover {
    color: black;
    background: $dash-accent;
}

.action-item:focus {
}


/* --- Sessions: input bars --------------------------------------- */

#session-search-input,
#new-session-input,
#delete-session-input {
    margin: 1 0;
}

#session-search-input:focus,
#new-session-input:focus,
#delete-session-input:focus {
    border: solid cyan;
}


/* --- Sessions: list --------------------------------------------- */

#session-list {
    height: auto;
    color: $dash-accent;
}

#session-list:focus {
    border: solid $dash-accent;
}

#session-list > .option-list--option-highlighted {
    color: black;
    background: $dash-accent 40%;
}

#session-list:focus > .option-list--option-highlighted {
    color: black;
    background: $dash-accent;
}


/* --- Utilities -------------------------------------------------- */

.hidden {
    display: none;
}
