/* --- Theme --------------------------------------------------------------- */

$color-primary: cyan;
$color-highlight: yellow;
$color-on-primary: black;


/* --- Screen -------------------------------------------------------------- */

DashboardScreen {
    padding: 0;
}

#sessions-section {
    margin: 0 4 1 4;
}


/* --- App banner ---------------------------------------------------------- */

#app-banner {
    height: 13;
    margin: 1 4 1 4;
}

.box {
    height: 13;
}

#app-icon {
    width: 26;
    padding: 1;
    border: solid $color-primary;
}

#app-config {
    margin-left: 1;
    padding-left: 1;
    border: solid $color-primary;
}


/* --- Models -------------------------------------------------------------- */

#model-section-title {
    height: auto;
}

#model-section-list {
    margin-left: 3;
    margin-bottom: 1;
}

.model-list {
    height: auto;
}

#model-type-list {
    max-width: 30;
}

#selected-model-list {
    color: $color-highlight;
}


/* --- Tokenizers ---------------------------------------------------------- */

#tokenizer-section-title {
    height: auto;
}

#tokenizer-section-list {
    margin-left: 3;
}

.tokenizer-list {
    height: auto;
}

#fallback-tokenizer {
    max-width: 30;
}

#selected-tokenizer {
    color: $color-highlight;
}


/* --- Sessions: title ----------------------------------------------------- */

#session-section-title {
    height: auto;
    margin-left: 1;
}


/* --- Sessions: action bar ------------------------------------------------ */

#session-action-bar {
    height: auto;
    padding-left: 1;
}

.action-item {
    width: auto;
    color: $color-primary;
    margin: 1 1 1 0;
}


/* --- Sessions: input bars ------------------------------------------------ */

#session-search-input,
#new-session-input,
#delete-session-input {
    margin: 1 0;
}

#session-search-input:focus,
#new-session-input:focus,
#delete-session-input:focus {
    border: solid $color-primary;
}


/* --- Sessions: list ------------------------------------------------------ */

#session-list {
    height: auto;
    color: $color-primary;
}

#session-list:focus {
    border: solid $color-primary;
}

#session-list > .option-list--option-highlighted {
    color: $color-on-primary;
    background: $color-primary 40%;
}

#session-list:focus > .option-list--option-highlighted {
    color: $color-on-primary;
    background: $color-primary;
}


/* --- Utilities ----------------------------------------------------------- */

.hidden {
    display: none;
}
