ChatInterface {
    layout: vertical;
    width: 100%;
    height: 100%;
}

#chat_interface {
    width: 100%;
    height: 1fr;
    padding: 1 2;
}

#prompt_input {
    width: 100%;
    height: auto;
}

.msg-box {
    width: 100%;
    height: auto;
    margin: 1 0;
    padding: 1 2;
}

.msg-label {
    width: 100%;
    height: 1;
    text-style: bold;
    margin-bottom: 1;
    color: white;
}

.user-box {
}

.user-box .msg-label {
    color: white;
}

.assistant-box {
}

.assistant-box .msg-label {
    color: white;
}
